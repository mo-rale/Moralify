{
  "name": "moralify",
  "version": "1.0.0",
  "description": "Desktop app that converts audio, video, image and document files",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.local.moralify",
    "productName": "Moralify",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
