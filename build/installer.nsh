; Explorer right-click: "Convert with Moralify" for every file type the app understands, and for folders.
; Registered per user (HKCU), so no admin rights are needed, and removed again on uninstall.
!macro MoralifyVerb ROOT
  WriteRegStr HKCU "${ROOT}\shell\Moralify" "" "Convert with Moralify"
  WriteRegStr HKCU "${ROOT}\shell\Moralify" "Icon" "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
  WriteRegStr HKCU "${ROOT}\shell\Moralify\command" "" '"$INSTDIR\${APP_EXECUTABLE_FILENAME}" "%1"'
!macroend
!macro MoralifyVerbRemove ROOT
  DeleteRegKey HKCU "${ROOT}\shell\Moralify"
!macroend

